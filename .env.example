# Foundr Environment Variables Template
# Copy this file to `.env.local` for local development and populate your own values.
# Never commit `.env`, `.env.local`, or real credentials.

# ------------------------------------------------------------------------------
# Core (Required on BOTH Vercel Next.js & Render Worker)
# ------------------------------------------------------------------------------
# MongoDB Atlas (or local MongoDB) connection URI
MONGODB_URI=mongodb://localhost:27017/foundr_dev
# Shared HS256 signing secret (>=32 random characters; must match identically on Vercel and Render)
JWT_SECRET=replace-with-a-random-32-plus-char-secret

# ------------------------------------------------------------------------------
# Redis (Required on BOTH Vercel Next.js & Render Worker)
# ------------------------------------------------------------------------------
# Hosted TCP Redis URL (configure maxmemory-policy=noeviction; never use REST-only URLs)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AI, Maps & Media Integrations (Vercel Next.js Web App)
# ------------------------------------------------------------------------------
# Groq API key for AI Risk Copilot (server-side /api/ai/analyze)
GROQ_API_KEY=your-groq-api-key
# Geoapify API key for India-scoped address autocomplete (public browser key)
NEXT_PUBLIC_GEOAPIFY_KEY=your-geoapify-public-key
# Cloudinary cloud name and unsigned upload preset (public browser upload config)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-unsigned-preset

# ------------------------------------------------------------------------------
# Email Dispatch (BOTH Vercel Next.js & Render Worker)
# ------------------------------------------------------------------------------
# Resend API key used for OTP and BullMQ transaction emails
RESEND_API_KEY=your-resend-api-key
# "sandbox" (default; routes emails safely to ADMIN_EMAIL/console) or "live" (requires verified Resend domain)
EMAIL_MODE=sandbox
# Admin inbox receiving sandbox email copies and fallback project alerts
ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Feature Flags (Vercel Next.js & Local Development)
# ------------------------------------------------------------------------------
# Server flag: "false" disables /api/auth/otp/{send,verify} (404); enable locally after setting up Resend
OTP_LOGIN_ENABLED=false
# Build-time client flag: "false" hides OTP recovery UI on /login
NEXT_PUBLIC_OTP_LOGIN_ENABLED=false
# Optional local-only flag: "true" shrinks delayed lifecycle job timers to seconds for quick demos
LIFECYCLE_DEMO_MODE=false
# Optional kill switch: "true" disables all Redis read/write caching (default unset/false = ON)
CACHE_DISABLED=false

# ------------------------------------------------------------------------------
# Payments - Razorpay Test Mode Simulation (Phase 4)
# ------------------------------------------------------------------------------
# Feature flag: "true" routes investor commitments through Razorpay Test Checkout (default unset/false = /invest ledger)
PAYMENTS_ENABLED=false
# Vercel + Render Worker (Server-only TEST key ID; MUST start with "rzp_test_")
RAZORPAY_KEY_ID=rzp_test_replace_me
# Vercel + Render Worker (Server-only secret used for Checkout signing, order checks & test refunds)
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
# Vercel ONLY (Server-only HMAC-SHA256 secret from Razorpay Test Webhook settings)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Reservation hold duration in minutes (default 15)
RESERVATION_TTL_MINUTES=15
# Optional local-only flag: "true" shrinks reservation expiry to 30 seconds for local demos
PAYMENTS_DEMO_MODE=false

# ------------------------------------------------------------------------------
# Worker & Realtime SSE (Render Worker + Vercel Build)
# ------------------------------------------------------------------------------
# Port bound by Express/BullMQ worker (set automatically by Render; defaults to 4000 locally)
PORT=4000
# Comma-separated CORS origins allowed by /worker SSE streams (Render worker)
FRONTEND_ORIGIN=http://localhost:3000
# Build-time public base URL of the /worker service used by browser EventSource and Bull Board handoff (Vercel)
NEXT_PUBLIC_WORKER_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Optional / Local & CI Testing Overrides (Vitest Only)
# ------------------------------------------------------------------------------
# Separate MongoDB URI for Vitest integration runs (falls back to MONGODB_URI with *_test DB guard)
MONGODB_URI_TEST=mongodb://localhost:27017
# Isolated MongoDB database name used during tests (MUST end with "_test")
MONGODB_DB_NAME=foundr_test
# Optional Redis key namespace override (Vitest automatically forces "test:" prefix)
REDIS_KEY_PREFIX=
